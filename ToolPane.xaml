<Page x:Class="RevitAutoAnnotate.ToolPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F2F5F8" FontFamily="Yu Gothic UI, Meiryo, Segoe UI"
 Foreground="#17273B" FontSize="13">
  <Page.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3,9,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,3,13,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#17605A"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" BorderBrush="#17605A" BorderThickness="1"
                    CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".86"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#D19536"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DCE4EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Page.Resources>
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#183746" Padding="16,13,16,16">
      <StackPanel>
        <TextBlock Text="施工図  /  床伏図" FontSize="11" Foreground="#9BD2C8" FontWeight="SemiBold"/>
        <TextBlock Text="自動寸法" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,6"/>
        <TextBlock x:Name="CurrentViewName" Foreground="#D2E5EA" Text="平面ビューを開いてください"/>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="13,13,13,8">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="対象範囲"/>
            <WrapPanel>
              <RadioButton x:Name="WholeView" Content="ビュー全体" IsChecked="True" GroupName="Range"/>
              <RadioButton Content="範囲を指定" GroupName="Range"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <TabControl SelectedIndex="0" BorderThickness="0" Background="Transparent" Padding="0,8,0,0">
          <TabItem Header="寸法">
            <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="対象部材と寸法設定"/>
            <WrapPanel Margin="0,0,0,7">
              <CheckBox x:Name="Axes" Content="通り芯間" IsChecked="True"
                        IsEnabled="{Binding IsChecked, ElementName=WholeView}" ToolTip="ビュー全体を対象に、通り芯間の寸法を作成します"/>
              <CheckBox x:Name="Columns" Content="柱" IsChecked="True"/>
              <CheckBox x:Name="Beams" Content="梁" IsChecked="True"/>
              <CheckBox x:Name="Walls" Content="壁" IsChecked="True"/>
              <CheckBox x:Name="Floors" Content="床端部" IsChecked="True"/>
              <CheckBox x:Name="Openings" Content="開口位置" IsChecked="True"/>
            </WrapPanel>
            <Label Content="寸法タイプ（共通）" Target="{Binding ElementName=Styles}" Padding="0,3"/>
            <ComboBox x:Name="Styles" DisplayMemberPath="Name" MinHeight="27" Margin="0,0,0,7"/>
            <Label Content="梁幅の表記" Target="{Binding ElementName=BeamWidths}" Padding="0,3"/>
            <ComboBox x:Name="BeamWidths" SelectedIndex="0" MinHeight="27" Margin="0,0,0,7"
                      AutomationProperties.Name="梁幅の表記">
              <ComboBoxItem Content="全幅" Tag="Overall"/>
              <ComboBoxItem Content="梁芯で分割" Tag="Split"/>
              <ComboBoxItem Content="梁幅を記入しない" Tag="Omit"/>
            </ComboBox>
            <Grid Margin="0,3,0,5">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <Label Padding="0,4" Content="1段目の離れ・柱以外（mm）" Target="{Binding ElementName=OffsetBox}"/>
              <TextBox x:Name="OffsetBox" Grid.Column="1" Text="600" Padding="5,3" Margin="0,0,0,4"
                       AutomationProperties.Name="1段目の離れ・柱以外（ミリメートル）"/>
              <Label Grid.Row="1" Padding="0,4" Content="柱の1段目の離れ（mm）" Target="{Binding ElementName=ColumnOffsetBox}"/>
              <TextBox x:Name="ColumnOffsetBox" Grid.Row="1" Grid.Column="1" Text="250" Padding="5,3" Margin="0,0,0,4"
                       AutomationProperties.Name="柱の1段目の離れ（ミリメートル）"/>
              <Label Grid.Row="2" Padding="0,4" Content="柱の寸法線間隔（mm）" Target="{Binding ElementName=ColumnRowGapBox}"/>
              <TextBox x:Name="ColumnRowGapBox" Grid.Row="2" Grid.Column="1" Text="360" Padding="5,3"
                       AutomationProperties.Name="柱の寸法線間隔（ミリメートル）"/>
            </Grid>
            <CheckBox x:Name="MoveTags" Content="寸法と重なる梁タグを移動" IsChecked="True"/>
          </StackPanel>
        </Border>
        <Button x:Name="RunButton" Content="寸法を作成" Click="RunClick" IsEnabled="False"/>
            </StackPanel>
          </TabItem>
          <TabItem Header="柱・梁タグ">
            <StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Label Content="柱タグタイプ" Target="{Binding ElementName=ColumnTagTypes}" Padding="0,3"/>
                  <ComboBox x:Name="ColumnTagTypes" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="27"
                            Margin="0,0,0,8" SelectionChanged="TagSelectionChanged"/>
                  <Label Content="梁タグタイプ" Target="{Binding ElementName=BeamTagTypes}" Padding="0,3"/>
                  <ComboBox x:Name="BeamTagTypes" DisplayMemberPath="Label" SelectedValuePath="Id" MinHeight="27"
                            SelectionChanged="TagSelectionChanged"/>
                </StackPanel>
              </Border>
              <Button x:Name="TagButton" Content="柱・梁タグを作成" Click="TagClick" IsEnabled="False"/>
            </StackPanel>
          </TabItem>
        </TabControl>
        <Border x:Name="ProgressCard" Visibility="Collapsed" Background="#EBF5EC" BorderBrush="#CFE4D3"
                BorderThickness="1" CornerRadius="8" Margin="0,9,0,0" Padding="10,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#D6ECDD" CornerRadius="14" Width="28" Height="28" Margin="0,0,9,0"
                    VerticalAlignment="Center">
              <TextBlock Text="🌱" FontFamily="Segoe UI Emoji" FontSize="15" Foreground="#287647"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="ProgressText" Foreground="#29573A" FontWeight="SemiBold" Margin="0,0,0,4"
                         AutomationProperties.LiveSetting="Polite"/>
              <ProgressBar x:Name="RunProgress" AutomationProperties.Name="作成の進捗"
                           Height="8" Minimum="0" Maximum="1" Foreground="#4BA66F" Background="#D5E8D8"/>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Text="対象ビューを開いてください" Margin="0,11,0,9" Foreground="#34556B"/>
        <Border Style="{StaticResource Card}" x:Name="ReviewCard" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Style="{StaticResource Section}" Text="要確認"/>
            <ListBox x:Name="ReviewList" MaxHeight="240" BorderBrush="#DCE4EB"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ReviewSelection">
              <ListBox.ItemTemplate><DataTemplate>
                <TextBlock Margin="2,3" Text="{Binding Message}" TextWrapping="Wrap"/>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="LocateButton" Margin="0,8,0,0" Content="選択した部材を表示"
                    Click="LocateClick" IsEnabled="False"/>
            <Button x:Name="PairButton" Margin="0,6,0,0" Content="選択した鉄骨に寸法を作成"
                    Click="ApplyPairClick" Visibility="Collapsed" IsEnabled="False"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Page>
